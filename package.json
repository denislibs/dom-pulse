{
  "name": "dom-pulse",
  "version": "0.1.0",
  "description": "Live DOM mutation stethoscope: heatmap overlay, cost signals, DOM diffs and stack attribution",
  "type": "module",
  "main": "./dist/dom-pulse.esm.js",
  "module": "./dist/dom-pulse.esm.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "node build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
